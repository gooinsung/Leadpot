# 백엔드 API 주소 (로컬 기본값). 실제 값은 .env 로 복사해서 사용.
# 배포 시 Cloudflare Pages 환경변수에 https://api.도메인 형태로 설정.
VITE_API_BASE_URL=http://localhost:8080

# 앱 도메인(절대 URL). 동의문서처럼 **앱 도메인에만 있는 경로**를 링크할 때 쓴다 —
# 상대 경로로 두면 서브도메인 사이트·외부 임베드에서 그 도메인에 붙어 404 가 난다(src/lib/site.ts).
# 비워두면 현재 접속 오리진을 쓴다(로컬 개발). 배포 시엔 https://app.도메인 으로 설정.
VITE_APP_BASE_URL=
